generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  clientId String @unique
}

model Chapter {
  id              String            @id @default(cuid())
  name            String
  chapterData     String
  topics          String[]
  chapterAnalysis ChapterAnalysis[]
}

model ChapterAnalysis {
  id                      String   @id @default(cuid())
  channelName             String   @default("")
  matchedSyllabusTopics   String[] @default([])
  unmatchedSyllabusTopics String[] @default([])
  unitCoveragePercentage  Float

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])

  matchedYoutubeTitles MatchedYoutubeTitle[]

  fallbackVideos ChapterAnalysisFallback[]
}

model ChapterAnalysisFallback {
  id           String @id @default(cuid())
  topicName    String
  ytVideoTitle String
  ytVideoId    String

  chapterAnalysisId String
  chapterAnalysis   ChapterAnalysis @relation(fields: [chapterAnalysisId], references: [id])
}

model MatchedYoutubeTitle {
  id           String @id @default(cuid())
  ytVideoTitle String
  ytVideoId    String

  chapterAnalysisId String
  chapterAnalysis   ChapterAnalysis @relation(fields: [chapterAnalysisId], references: [id])
}
